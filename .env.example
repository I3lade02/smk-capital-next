# Endpointy PHP skriptů, které na hostingu Endora odesílají formuláře e-mailem.
# Zůstávají přesně takové, jaké jsou na smkcapital.cz dnes – nové stránky
# posílají data na stejné adresy, takže na hostingu není potřeba nic měnit.
#
# Pokud jsou PHP skripty na stejné doméně jako web (běžný případ v produkci),
# stačí relativní cesty:
# NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=/contact.php
# NEXT_PUBLIC_CAR_INSURANCE_ENDPOINT=/car-insurance.php
# NEXT_PUBLIC_MORTGAGE_CALCULATION_ENDPOINT=/mortgage-calculation.php
# NEXT_PUBLIC_CONTRACT_REVIEW_ENDPOINT=/contract-review.php
#
# Při vývoji na localhostu je potřeba absolutní adresa na ostrý hosting
# (a na straně PHP povolené CORS hlavičky):
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=https://smkcapital.cz/contact.php
NEXT_PUBLIC_CAR_INSURANCE_ENDPOINT=https://smkcapital.cz/car-insurance.php
NEXT_PUBLIC_MORTGAGE_CALCULATION_ENDPOINT=https://smkcapital.cz/mortgage-calculation.php
NEXT_PUBLIC_CONTRACT_REVIEW_ENDPOINT=https://smkcapital.cz/contract-review.php
